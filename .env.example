# Copier ce fichier en .env puis renseigner la cle.
#   cp .env.example .env
# Le fichier .env est ignore par git (voir .gitignore).

# Cle Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modeles : redaction de l'acte, et juge de la double passe.
GEMINI_MODELE_REDACTION=gemini-3.1-flash-lite
GEMINI_MODELE_JUGE=gemini-3.5-flash-lite

# Mettre a 1 pour interdire tout appel reseau et n'utiliser que cache/.
# C'est le mode dans lequel tourne la CI, et celui d'un relecteur sans cle.
CONTROLE_PIECES_OFFLINE=0
